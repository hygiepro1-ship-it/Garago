generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Les URLs sont configurées dans prisma.config.ts via l'adaptateur PrismaPg (Prisma 7)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password         String?
  role             String    @default("DRIVER")
  phone            String?
  notifPref        String    @default("EMAIL") // "EMAIL" | "SMS" | "BOTH"
  marketingConsent Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  garages      Garage[]
  reviews      Review[]
  favorites    GarageFavorite[]
  vehicles     UserVehicle[]
  appointments Appointment[]
  reminders    MaintenanceReminder[]
}

model Garage {
  id          String  @id @default(cuid())
  ownerId     String?   // null tant que la fiche n'est pas réclamée (voir claimStatus)
  parentId    String?   // null = garage principal ; sinon succursale rattachée à ce garage
  name        String
  slug        String  @unique
  description           String?
  descriptionDraft      String?   // awaiting admin approval
  descriptionStatus     String    @default("APPROVED") // APPROVED | PENDING | REJECTED
  descriptionChanges    Int       @default(0)   // nb de soumissions cette année
  descriptionChangesYear Int?                   // année de référence
  address     String
  city        String
  province    String  @default("QC")
  postalCode  String
  phone       String
  email       String?
  website     String?
  logoUrl          String?
  logoPosition     String  @default("center") // "top" | "center" | "bottom"
  coverUrl         String?
  coverPosition    String  @default("center") // "top" | "center" | "bottom"
  latitude    Float?
  longitude   Float?

  subscriptionStatus String    @default("TRIAL")
  subscriptionEndAt  DateTime?
  pastDueSince       DateTime?  // début de la période de grâce quand un paiement échoue
  cancelAtPeriodEnd  Boolean   @default(false)
  stripeCustomerId   String?
  stripePriceId      String?
  cardReminderCount  Int       @default(0)   // nb de relances "carte manquante" envoyées
  cardReminderSentAt DateTime?               // dernière relance envoyée

  neq                String?                 // Numéro d'entreprise du Québec (10 chiffres), fourni à l'inscription
  verificationStatus String    @default("APPROVED") // APPROVED | PENDING | REJECTED — vérification manuelle du NEQ avant visibilité publique

  // Fiches pré-créées (stratégie "Doctolib") : un garage importé à partir de
  // données publiques existe avant même d'avoir un propriétaire. Non lié à
  // verificationStatus, qui concerne le NEQ des garages déjà abonnés.
  claimStatus     String    @default("activee") // non_reclamee | en_attente | activee
  hiddenByReport  Boolean   @default(false)     // masquée immédiatement sur demande de retrait (fiche non activée)

  referralCode          String?  @unique
  referredByCode        String?
  referralRewardGranted Boolean  @default(false)
  referralCount         Int      @default(0)
  referralCommissionEarned Float @default(0)
  ambassadorTier        Int      @default(0)  // 0=none 1=stats 2=disc10 3=disc20 4=priority 5=certified
  isAmbassador          Boolean  @default(false) // true = tier 5 (certified)
  ambassadorSince       DateTime?
  palier2Applied        Boolean  @default(false) // -10% discount already given
  palier3Applied        Boolean  @default(false) // -20% discount already given
  palier4Expiry         DateTime? // priority search expiry

  emailPublic     Boolean @default(false)
  yearFounded     Int?
  employeeCount   Int?
  languages       String?
  openingHours    String?
  acceptsWalkIn   Boolean @default(true)
  appointmentOnly Boolean @default(false)
  hourlyRate      Float?
  requireConfirmation Boolean @default(true) // le client doit confirmer son rendez-vous par courriel, sinon le créneau est libéré
  capacity        Int     @default(1) // nb de véhicules pris en charge en même temps (postes de travail / employés) — un créneau n'est complet que lorsque tous les postes sont occupés

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User?                @relation(fields: [ownerId], references: [id])
  parent       Garage?              @relation("GarageBranches", fields: [parentId], references: [id], onDelete: SetNull)
  branches     Garage[]             @relation("GarageBranches")
  services     GarageService[]
  brands       GarageBrand[]
  brandModels  GarageBrandModel[]
  reviews      Review[]
  favorites    GarageFavorite[]
  availability GarageAvailability[]
  photos       GaragePhoto[]
  appointments Appointment[]
  blockedSlots BlockedSlot[]
  alerts       GarageAlert[]
  profileViews GarageProfileView[]
  claimRequests ClaimRequest[]
  reports       GarageReport[]

  @@index([ownerId])
  @@index([parentId])
  @@index([claimStatus])
}

// ── Fiches pré-créées ("Doctolib") ──────────────────────────────────────────

model ClaimRequest {
  id          String   @id @default(cuid())
  garageId    String
  name        String
  role        String   // "proprietaire" | "gerant"
  phone       String
  email       String
  neq         String?
  proofNote   String?  // référence à la pièce justificative (envoyée par courriel pour l'instant)
  status      String   @default("en_attente") // en_attente | approuvee | refusee
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([status])
}

model GarageReport {
  id            String   @id @default(cuid())
  garageId      String
  reason        String   // "usurpation" | "erreur" | "retrait" | "autre"
  message       String?
  reporterEmail String?
  status        String   @default("nouveau") // nouveau | traite
  createdAt     DateTime @default(now())

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // ex. "claim_request_created", "claim_approved", "claim_rejected", "report_created", "fiche_imported"
  targetType String   // "Garage" | "ClaimRequest" | "GarageReport"
  targetId   String
  actorEmail String?  // courriel de l'admin ou du demandeur, quand applicable
  detail     String?  // texte libre, contexte additionnel
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model GarageProfileView {
  id        String   @id @default(cuid())
  garageId  String
  createdAt DateTime @default(now())

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId, createdAt])
}

// Visite anonyme du site (une par session de navigateur, pas par page vue) —
// alimente le tableau de bord admin (visiteurs vs inscriptions). Aucune donnée
// personnelle : visitorId est un identifiant aléatoire stocké dans un cookie.
model SiteVisit {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
}

model GarageAlert {
  id          String   @id @default(cuid())
  garageId    String
  type        String   // "LOW_RATING" | "BAD_STREAK" | "ONE_STAR"
  message     String
  avgRating   Float?
  reviewCount Int?
  isRead      Boolean  @default(false)
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
}

model GarageService {
  id          String  @id @default(cuid())
  garageId    String
  categoryId  String
  name        String
  description String?
  priceMin    Float?
  priceMax    Float?
  durationMin Int?
  active      Boolean @default(true)

  garage   Garage          @relation(fields: [garageId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])
}

model ServiceCategory {
  id          String @id @default(cuid())
  name        String
  nameEn      String?
  icon        String?
  description String?
  sortOrder   Int    @default(0)

  services GarageService[]
}

model GarageBrand {
  id       String  @id @default(cuid())
  garageId String
  brand    String
  accepts  Boolean @default(true)
  note     String?

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([garageId, brand])
  @@index([garageId])
}

// Modèles précis traités par un garage pour une marque acceptée.
// Absence de lignes pour (garageId, brand) = tous les modèles de cette marque
// sont traités (compatibilité avec les garages déjà inscrits avant cette fonctionnalité).
model GarageBrandModel {
  id       String @id @default(cuid())
  garageId String
  brand    String
  model    String

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([garageId, brand, model])
  @@index([garageId, brand])
}

model GarageAvailability {
  id        String  @id @default(cuid())
  garageId  String
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([garageId, dayOfWeek])
}

model GaragePhoto {
  id        String  @id @default(cuid())
  garageId  String
  url       String
  caption   String?
  sortOrder Int     @default(0)

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
}

model Review {
  id           String   @id @default(cuid())
  garageId     String
  userId       String
  rating       Int
  title        String?
  comment      String?
  service      String?
  vehicleMake  String?
  vehicleModel String?
  vehicleYear  Int?
  ownerReply   String?
  isVerified   Boolean  @default(false)
  isHidden     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([garageId])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  garageId  String
  date      String   // "YYYY-MM-DD"
  startTime String?  // "HH:MM" — null if allDay
  endTime   String?  // "HH:MM" — null if allDay
  reason    String?
  allDay    Boolean  @default(false)
  createdAt DateTime @default(now())

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId, date])
}

model GarageFavorite {
  id        String   @id @default(cuid())
  userId    String
  garageId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([userId, garageId])
}

model UserVehicle {
  id           String   @id @default(cuid())
  userId       String
  year         Int
  make         String
  model        String
  trim         String?
  color        String?
  mileage      Int?
  licensePlate String?
  vin          String?
  tireSize     String?
  specs        String?  // JSON : engine, fuel, transmission, driveType, doors, bodyType, recalls[]
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user      User                  @relation(fields: [userId], references: [id])
  reminders MaintenanceReminder[]
}

model MaintenanceReminder {
  id           String    @id @default(cuid())
  userId       String
  vehicleId    String?
  title        String
  notes        String?
  dueDate      DateTime?
  priority     String    @default("SOON") // URGENT | SOON | LOW
  done         Boolean   @default(false)
  reminderSent Boolean   @default(false)
  createdAt    DateTime  @default(now())

  user    User         @relation(fields: [userId], references: [id])
  vehicle UserVehicle? @relation(fields: [vehicleId], references: [id])
}

// ── Rendez-vous ────────────────────────────────────────────────────────────

model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  verified  Boolean  @default(false)
  attempts  Int      @default(0) // mauvais essais — code invalidé après 5 (anti brute-force)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  attempts  Int      @default(0) // mauvais essais — code invalidé après 5 (anti brute-force)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// Anti-spam : limite le nombre d'inscriptions par IP dans une fenêtre de temps
model RegistrationAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// Anti-brute-force : compte les échecs de connexion par courriel dans une fenêtre de temps
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model AutoTip {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   // "entretien" | "securite" | "saisonnier" | "economie" | "electrique" | "achat"
  season      String   // "printemps" | "ete" | "automne" | "hiver" | "toute_annee"
  publishAt   DateTime // date planifiée d'envoi (lundi matin)
  sentAt      DateTime?
  year        Int      // année de publication (pour l'agent annuel)

  @@index([publishAt])
  @@index([sentAt])
}

model Suggestion {
  id          String   @id @default(cuid())
  content     String
  authorName  String?
  authorEmail String?
  status      String   @default("PENDING") // PENDING | READ | DONE
  adminNote   String?
  createdAt   DateTime @default(now())
}

model SupportQuestion {
  id          String   @id @default(cuid())
  type        String   // "DRIVER" | "GARAGE"
  question    String
  authorName  String?
  authorEmail String?
  status      String   @default("PENDING") // PENDING | ANSWERED | CLOSED
  createdAt   DateTime @default(now())
}

model Appointment {
  id       String @id @default(cuid())
  garageId String
  userId   String? // null = manuel (client hors plateforme)

  // Infos client (obligatoires pour manuels, pré-remplies pour membres)
  customerName  String
  customerPhone String
  customerEmail String?

  // Véhicule — copié au moment de la réservation (pas de FK vers UserVehicle,
  // le véhicule peut être modifié/supprimé ensuite sans affecter l'historique du garage)
  vehicleYear  Int?
  vehicleMake  String?
  vehicleModel String?
  vehicleTrim  String?
  vehicleVin   String?
  vehicleTireSize String?
  vehicleSpecs String? // JSON : engine, fuel, transmission, driveType, doors, bodyType, recalls[]

  // Service demandé
  serviceName String?

  // Plage horaire
  date      String // "YYYY-MM-DD"
  startTime String // "HH:MM"
  endTime   String // "HH:MM"

  // Gestion
  status        String  @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED | NO_SHOW
  source        String  @default("ONLINE")  // ONLINE | MANUAL
  notes          String?
  completionNote String? // Note du garage au client quand véhicule terminé
  reminderSent   Boolean @default(false)

  // Confirmation par le client (voir src/lib/rdv-confirmation.ts). Les rendez-vous
  // existants et manuels restent NOT_REQUIRED : la règle ne s'applique qu'aux
  // nouvelles réservations en ligne.
  confirmationStatus String    @default("NOT_REQUIRED") // NOT_REQUIRED | SCHEDULED | AWAITING | CONFIRMED | EXPIRED
  confirmTier        String? // STANDARD | LAST_MINUTE
  confirmBy          DateTime? // échéance : sans confirmation, le créneau est libéré
  confirmToken       String?   // aléatoire (192 bits) — sert de lien dans les courriels
  confirmRequestedAt DateTime?
  confirmNudgeAt     DateTime?
  arrivalReminderAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([garageId])
  @@index([userId])
  @@index([garageId, date])
  @@index([confirmationStatus, date])
  @@index([confirmToken])
}

/// Réglages globaux du site — une seule ligne (id fixe "singleton").
model SiteSetting {
  id                 String    @id @default("singleton")
  maintenanceMode    Boolean   @default(false)
  maintenanceMessage String?
  maintenanceUntil   DateTime?
  updatedAt          DateTime  @updatedAt
}
