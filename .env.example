# ── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/db?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/db"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="https://ton-domaine.ca"
NEXTAUTH_SECRET=""

# ── Admin ─────────────────────────────────────────────────────────────────────
# Secret pour les URLs d'approbation/rejet de descriptions (OBLIGATOIRE en prod)
ADMIN_REVIEW_SECRET=""
ADMIN_EMAIL="info.garago@gmail.com"

# ── Google OAuth (connexion rapide) — optionnel, désactivé si absent ──────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Garago <support@garagopro.ca>"

# ── SMS (Twilio) — optionnel, désactivé si absent ─────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Cron (Vercel Scheduled Functions) — OBLIGATOIRE en prod ───────────────────
# Sans cette clé, les rappels de RDV et conseils hebdo ne partiront jamais (401 silencieux)
CRON_SECRET=""

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID=""
# Prix annuel — optionnel. Absent = le bouton "annuel" échoue proprement (Stripe non configuré),
# le plan mensuel continue de fonctionner normalement.
STRIPE_PRICE_ID_ANNUAL=""
# Garage supplémentaire (multi-garages) — +49,99 $/mois, ou 479,88 $/an (−20 %).
# Absents = les succursales ne sont pas facturées (le garage principal paie seul).
STRIPE_PRICE_ID_EXTRA=""
STRIPE_PRICE_ID_EXTRA_ANNUAL=""
STRIPE_WEBHOOK_SECRET=""
SUBSCRIPTION_PRICE_CENTS=4900
